# API da Anthropic (obrigatória para processar PDFs)
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
ANTHROPIC_MODEL=claude-sonnet-4-6

# Supabase (ao preencher as duas variáveis, contas individuais e histórico são ativados)
NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxx

# Fallback temporário: usado apenas quando o Supabase NÃO está configurado.
APP_ACCESS_PASSWORD=troque-por-uma-senha-forte
APP_SESSION_SECRET=troque-por-um-segredo-longo-e-aleatorio

# Tamanho máximo de cada PDF, em MB
MAX_PDF_SIZE_MB=10
