# API da Anthropic (obrigatória para processar os PDFs)
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Modelo usado pela aplicação
ANTHROPIC_MODEL=claude-sonnet-4-6

# Proteção simples para compartilhar o link com pessoas autorizadas.
# Se APP_ACCESS_PASSWORD ficar vazio, o sistema permanecerá público.
APP_ACCESS_PASSWORD=troque-por-uma-senha-forte

# Use uma sequência longa e aleatória, diferente da senha acima.
APP_SESSION_SECRET=troque-por-um-segredo-longo-e-aleatorio

# Tamanho máximo de cada PDF, em MB
MAX_PDF_SIZE_MB=10
